import serial
import zlib

# Настройка порта
port_name = 'COM19'  
baud_rate = 9600
ser = serial.Serial(port_name, baud_rate)


def calculate_checksum(data):
    """Вычислить контрольную сумму."""
    return zlib.crc32(data.encode())


print(f"Слушаем порт {port_name}...")

while True:
    if ser.in_waiting > 0:
        received_data = ser.read_until().decode().strip()
        try:
            message, received_checksum = received_data.rsplit('(', 1)
            received_checksum = int(received_checksum.strip(')'))
            calculated_checksum = calculate_checksum(message)

            print(f"Получено сообщение: {message}")
            if received_checksum == calculated_checksum:
                print("Контрольные суммы совпадают.")
            else:
                print("Ошибка контрольной суммы!")
        except ValueError:
            print("Некорректный формат данных.")




