#define N 500  

struct table {
	char orignalkey[40];
	int  hashkey;
	table* next;
	int size;
};

struct table* info = NULL;

int makehash(char* str)
{
	int hash = 0, square = 0;
	for (int i = 0; i < strlen(str) - 1; i++)
	{
		hash = str[i] + hash;
	}
	square = hash * hash;
	return ((square >> 14) % 16384);
}

struct table* createhashtable(FILE* file, struct table* info)
{
	unsigned int square = 0, i = 0, hash = 0, hashkey = 0;
	char str[40];
	info = new struct table[N];
	for (int i = 0; i < N; i++)
	{
		info[i].hashkey = NULL;
		info[i].next = NULL;
		strcpy(info[i].orignalkey, "");
	}
	while (!feof(file))
	{
		fgets(str, 255, file);
		hashkey = makehash(str);
		for (int j = 0; j < N; j++)
		{
			if (j == hashkey) {
				if (info[j].hashkey != NULL)
				{
					struct table* p;
					table* list = new table;
					p = info[j].next;
					while (p != NULL)
					{
						p = p->next;
					}
					p = info[j].next;
					info[j].next = list;
					list->hashkey = info[j].hashkey;
					strcpy(list->orignalkey, str);
					list->next = p;
					break;
				}
				else {
					strcpy(info[j].orignalkey, str);
					info[j].hashkey = hashkey;
					break;
				}
			}
		}
		i++;
	}
	info->size = i;
	return info;
}

struct table* addelem(char str[40], struct table* info)
{
	int h = 0;
	h = makehash(str);
	if (info[h].hashkey != NULL)
	{
		struct table* p;
		table* list = new table;
		p = info[h].next;
		while (p != NULL)
		{
			p = p->next;
		}
		p = info[h].next;
		info[h].next = list;
		list->hashkey = info[h].hashkey;
		strcpy(list->orignalkey, str);
		list->next = p;

	}
	else {
		strcpy(info[h].orignalkey, str);
		info[h].hashkey = h;
	}
	if (h > N) { printf("Элемент не добавлен!\n"); }
	else { printf("Элемент добавлен!\n"); }
	info->size++;
	return info;
}

struct table* deleteelem(char str[40], struct table* info)
{
	int h = 0;
	h = makehash(str);
	info[h].hashkey = NULL;
	strcpy(info[h].orignalkey, "");
	if (info[h].next != NULL)
	{
		struct table* p;
		p = info[h].next;
		while (p != NULL) {
			p->hashkey = NULL;
			strcpy(p->orignalkey, "");
			p = p->next;
		}
	}
	if (h > N) { printf("Элемента нет в хэш-таблице!"); }
	info->size--;
	return info;
}

void search(char str[40], struct table* info)
{

	int h = 0;
	h = makehash(str);
	if (info[h].hashkey == h)
	{
		printf("Найденный элемент:\n");
		printf("Code:%d | %s ", info[h].hashkey, info[h].orignalkey);
		if (info[h].next != NULL)
		{
			struct table* p;
			p = info[h].next;
			while (p != NULL) {
				printf(" -> Code:%d | %s ", p->hashkey, p->orignalkey);
				p = p->next;
			}
		}
	}
	else { printf("Элемент не найден\n"); }
}

struct table* rehashing(struct table* info, char str[40])
{
	int h = 0;
	h = makehash(str);
	while (info[h].hashkey != NULL)
	{
		h++;
	}
	strcpy(info[h].orignalkey, str);
	info[h].hashkey = h;
	return info;
}

void printhashtable(struct table* info)
{

	for (int i = 0; i < N; i++)
	{
		if (info[i].hashkey == NULL)
			continue;
		printf("Code:%d | %s ", info[i].hashkey, info[i].orignalkey);
		if (info[i].next != NULL)
		{
			struct table* p;
			p = info[i].next;
			while (p != NULL) {
				printf(" -> Code:%d | %s ", p->hashkey, p->orignalkey);
				p = p->next;
			}
		}
	}
}

