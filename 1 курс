				return 0;
		if ((unsigned char)*s1 > (unsigned char)*s2)
			return 1;
		else
			return -1;
	}

	Spreadsheet::Spreadsheet(int len) {
		this->len = len;
		this->contain = 0;
		this->buff = new Record[len];
	}

	void Spreadsheet::addrecord(Record r) {
		this->buff[contain] = r;
		this->contain++;
	}

	void Spreadsheet::write(char filename[]) {
		std::ofstream file;
		file.open(filename);
		if (!file.is_open()) {
			std::cout << "Can't open file!" << std::endl;
			return;
		}
		int n = this->contain;
		for (int i = 0; i < n; i++) {
			Record r = this->buff[i];
			file << r.name << " ";
			file << r.type << " ";
			file << r.flights_number << " ";
			file << r.flights_km << " ";
			file << r.traffic << " ";
		}
		file.close();
	}

