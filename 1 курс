#include "mylib.h"
#include <iostream>
#include <fstream>
#include <iomanip>

namespace mylib {
	int myatoi(char* s) {
		int res = 0;
		for (; *s; res += *s++ - '0') {
			res *= 10;
		}
		return res;
	}

	int mystrcmp(const char* s1, const char* s2)
	{
		for (; *s1 == *s2; ++s1, ++s2)
			if (*s2 == '\0')
				return 0;
		if ((unsigned char)*s1 > (unsigned char)*s2)
			return 1;
		else
			return -1;
	}

	void Spreadsheet::addrecord(Record r) {
		this->buff.push_back(r);
	}

	void Spreadsheet::write(char filename[]) {
		std::ofstream file;
		file.open(filename);
		if (!file.is_open()) {
			std::cout << "Can't open file!" << std::endl;
			return;
		}
		int n = this->buff.size();
		for (int i = 0; i < n; i++) {
			Record r = this->buff[i];
			file << r.name << " ";
			file << r.type << " ";
			file << r.flights_number << " ";
			file << r.flights_km << " ";
			file << r.traffic << " ";
		}
		file.close();
	}

	void Spreadsheet::read(char filename[]) {
		std::ifstream file;
		file.open(filename);
		if (!file.is_open()) {
			std::cout << "Can't open file!" << std::endl;
			return;
		}
		while (!file.eof()) {
			Record r;
			char stemp[30];
			int itemp;
			if (!(file >> stemp))
				break;
			r.name = stemp;
			if (!(file >> stemp))
				break;
			r.type = stemp;
			if (!(file >> itemp))
				break;
			r.flights_number = itemp;
			if (!(file >> itemp))
				break;
			r.flights_km = itemp;
			if (!(file >> itemp))
				break;
			r.traffic = itemp;
			this->buff.push_back(r);
		}
		file.close();
	}

	void Spreadsheet::print(int n) {
		if (n > this->buff.size()) {
			n = this->buff.size();
		}
		for (int i = 0; i < n; i++) {
			Record r = this->buff[i];
			std::cout << std::setw(15) << r.name << " ";
			std::cout << std::setw(15) << r.type << " ";
			std::cout << std::setw(15) << r.flights_number << " ";
			std::cout << std::setw(15) << r.flights_km << " ";
			std::cout << std::setw(15) << r.traffic << "\n";
		}
	}
}

