#include "mystring.h"
#include <cstring>

namespace mystring {
	void String::Set(const char* str)
	{
		if (str == nullptr)
			return;

		length = strlen(str);
		buffer = new char[length + 1];

		for (int i = 0; i < length; i++) buffer[i] = str[i];

		buffer[length] = '\0';
	}

	String::String()
	{
		buffer = nullptr;
		length = 0;
	}

	String::String(const char* str) : String()
	{
		this->Set(str);
	}

	String::String(const String& other) : String()
	{
		this->Set(other.buffer);
	}

	String::String(String&& other)
	{
		this->length = other.length;
		this->buffer = other.buffer;

		other.buffer = nullptr;
	}

	String::~String()
	{
		if (buffer != nullptr) delete[]buffer;
	}

	String& String::operator = (const String& other)
	{
		if (this->buffer != nullptr)
			delete[]buffer;

		Set(other.buffer);

		return *this;
	}
	String& String::operator = (const char* str)
	{
		if (this->buffer != nullptr)
			delete[]buffer;

		Set(str);

		return *this;
	}

	String String::operator +(const String& other)
	{
		String newStr;
		int thisLenght = 0;
		int otherLenght = 0;

		if (this->buffer != nullptr) thisLenght = strlen(this->buffer);
		if (other.buffer != nullptr) otherLenght = strlen(other.buffer);

		newStr.length = thisLenght + otherLenght;

		newStr.buffer = new char[thisLenght + otherLenght + 1];
		int i = 0;

		for (; i < thisLenght; i++) newStr.buffer[i] = this->buffer[i];
		for (int j = 0; j < otherLenght; j++, i++) newStr.buffer[i] = other.buffer[j];

		newStr.buffer[thisLenght + otherLenght] = '\0';

		return newStr;
	}

	String String::operator +(const char* str)
	{
		String newStr;
		int thisLenght = 0;
		int otherLenght = 0;

		if (this->buffer != nullptr) thisLenght = strlen(this->buffer);

		otherLenght = strlen(str);

		newStr.length = thisLenght + otherLenght;

		newStr.buffer = new char[thisLenght + otherLenght + 1];
		int i = 0;

		for (; i < thisLenght; i++) newStr.buffer[i] = this->buffer[i];
		for (int j = 0; j < otherLenght; j++, i++) newStr.buffer[i] = str[j];

		newStr.buffer[thisLenght + otherLenght] = '\0';

		return newStr;
	}

	bool String::operator == (const String& other)
	{
		if (other.length != this->length) return false;

		for (int i = 0; i < this->length; i++)
		{
			if (this->buffer[i] != other.buffer[i])
				return false;
		}

		return true;
	}

	bool String::operator == (const char other[]) const
	{
		if (strlen(other) != this->length) return false;

		for (int i = 0; i < this->length; i++)
		{
			if (this->buffer[i] != other[i])
				return false;
		}

		return true;
	}

	bool String::operator != (const String& other)
	{
		return !(this->operator==(other));
	}

	bool String::operator > (const String& other)
	{
		int len = (this->length < other.length) ? this->length : other.length;

		for (int i = 0; i < len; i++)
		{
			if (int(this->buffer[i]) > int(other.buffer[i]))
				return true;
			else if (int(this->buffer[i]) < int(other.buffer[i]))
				return false;
		}

		if (this->length == len)
			return false;
		else
			return true;
	}

	bool String::operator >= (const String& other)
	{
		int len = (this->length < other.length) ? this->length : other.length;

		for (int i = 0; i < len; i++)
		{
			if (int(this->buffer[i]) < int(other.buffer[i]))
				return false;
		}
		if (this->length == len)
		{
			if (this->length == other.length)
				return true;
			else
				return false;
		}
		return true;
	}

	bool String::operator < (const String& other)
	{
		return !(this->operator>(other));
	}

	bool String::operator <= (const String& other)
	{
		int len = (this->length < other.length) ? this->length : other.length;

		for (int i = 0; i < len; i++)
		{
			if (int(this->buffer[i]) > int(other.buffer[i]))
				return false;
		}
		if (this->length == len)
			return true;
		return false;
	}

	char& String::operator [](int index)
	{
		return this->buffer[index];
	}

	std::ostream& operator<< (std::ostream& os, const String& str)
	{
		os << str.buffer;
		return os;
	}
	std::istream& operator>> (std::istream& is, String& str)
	{
		std::streamsize n = 60;
		char buf[60];
		is.getline(buf, n - 1);
		buf[n - 1] = '\0';
		str.Set(buf);
		return is;
	}

	int String::Length() const
	{
		return length;
	}

	char* String::Get()
	{
		return buffer;
	}

	const char* String::data() const
	{
		if (buffer == nullptr)
			throw std::invalid_argument("Error: arg = nullptr.");

		return buffer;
	}

	char* String::toString(int val)
	{
		char res[64];
		std::snprintf(res, 64, "%d", val);
		return res;
	}
}


