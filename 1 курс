Надо: Вычислить и напечатать таблицу значений функции и сумму ее значений для всех пар аргументов при x[a,b) с шагом hx, y[c,d) с шагом hy. Вычисление f(x,y) для одной пары значений аргументов определить в отдельной функции.
#include <iostream>
#include <iomanip>

#define PI 3.1415926535

double my_abs(double a);
double my_pow(double a, double n);
double my_log(double a);
double my_arctg(double a);
double my_sin(double a);
double my_cos(double a);
double my_tg(double a);
double my_exp(double a);

double my_abs(double a) {
	return a > 0 ? a : -a;
}

double my_pow(double a, double n) {
	return my_exp(n * my_log(a));
}

double my_log(double a) {
	double eps = 1e-6;
	double res = 0.0;
	double q = (a - 1.0) / (a + 1.0);
	double n = 1.0;
	while (my_abs(q) > eps)
	{
		res += q;
		n += 2.0;
		q *= (a - 1.0) * (a - 1.0) / (a + 1.0) / (a + 1.0) * (n - 2.0) / (n);
	}
	return res * 2;
}

double my_arctg(double a) {
	if (my_abs(a) <= 1)
	{
		double eps = 1e-6;
		double res = 0.0;
		double q = a;
		double n = 1.0;
		while (my_abs(q) > eps)
		{
			res += q;
			n += 2.0;
			q *= -a * a * (n - 2.0) / (n);
		}
		return res;
	}
	else
	{
		return PI / 2 - my_arctg(1 / a);
	}
}

double my_sin(double a) {
	double eps = 1e-6;
	double res = 0.0;
	double q = a;
	double n = 1.0;
	while (my_abs(q) > eps)
	{
		res += q;
		n += 2.0;
		q *= -a * a / (n - 1) / (n);
	}
	return res;
}

double my_cos(double a) {
	double eps = 1e-6;
	double res = 0.0;
	double q = 1.0;
	double n = 0.0;
	while (my_abs(q) > eps)
	{
		res += q;
		n += 2.0;
		q *= -a * a / (n - 1) / (n);
	}
	return res;
}

double my_exp(double a) {
	double eps = 1e-6;
	double res = 1;
	double q = 1;
	double  i = 1;
	while (q > eps)
	{
		q *= a / i;
		res += q;
		i++;
	}
	return res;
}

double my_tg(double a) {
	return my_sin(a) / my_cos(a);
}

double func(double x, double y) {
	if (x < y)
	{
		return my_pow(1.0 + my_abs(y), 2.0 * x);
	}
	else if (x > y)
	{
		return my_tg(x + y);
	}
	else
	{
		return my_pow(y, 2.0 / 3.0) * my_arctg(x + y);
	}
}


