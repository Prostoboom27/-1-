from Crypto.Cipher import DES
from Crypto.Random import get_random_bytes

def des_ofb_encrypt(plaintext, key, iv):
    """
    Encrypt plaintext using DES in OFB mode.

    :param plaintext: The plaintext to encrypt (bytes)
    :param key: The DES key (8 bytes)
    :param iv: The initialization vector (8 bytes)
    :return: The ciphertext (bytes)
    """
    cipher = DES.new(key, DES.MODE_OFB, iv)
    ciphertext = cipher.encrypt(plaintext)
    return ciphertext

def des_ofb_decrypt(ciphertext, key, iv):
    """
    Decrypt ciphertext using DES in OFB mode.

    :param ciphertext: The ciphertext to decrypt (bytes)
    :param key: The DES key (8 bytes)
    :param iv: The initialization vector (8 bytes)
    :return: The plaintext (bytes)
    """
    cipher = DES.new(key, DES.MODE_OFB, iv)
    plaintext = cipher.decrypt(ciphertext)
    return plaintext

