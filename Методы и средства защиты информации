class PlayfairCipher:
    def __init__(self, key):
        # Алфавит для шифрования
        self.alph = "абвгдежзийклмнопрстуфхцчшщъыьэюя"
        # Создание матрицы на основе ключа
        self.matrix = self.create_matrix(key)
        # Вывод матрицы
        self.print_matrix()

    def create_matrix(self, key):
        # Удаление дубликатов из ключа и сохранение их порядка
        key = ''.join(sorted(set(key), key=key.index))
        # Расширение алфавита с добавлением оставшихся букв не входящих в ключ
        extended_alph = key + ''.join([ch for ch in self.alph if ch not in key])
        # Создание 5x5 матрицы
        return [list(extended_alph[i:i+5]) for i in range(0, 25, 5)]

    def print_matrix(self):
        # Вывод матрицы
        for row in self.matrix:
            print(' '.join(row))

    def prepare_text(self, text):
        # Преобразование текста в нижний регистр и удаление пробелов
        text = text.lower().replace(" ", "")
        # Если длина текста нечетная, добавление заполнителя 'ъ'
        if len(text) % 2 != 0:
            text += 'ъ'
        return text

    def find_position(self, char):
        # Поиск позиции символа в матрице
        for i, row in enumerate(self.matrix):
            if char in row:
                return (i, row.index(char))
        return None  # Возвращает None, если символ не найден

    def encrypt_pair(self, pair):
        # Находим позиции символов пары
        pos1 = self.find_position(pair[0])
        pos2 = self.find_position(pair[1])

        if pos1 and pos2:  # Проверяем, что позиции найдены
            if pos1[0] == pos2[0]:  # Одинаковая строка
                return self.matrix[pos1[0]][(pos1[1] + 1) % 5], self.matrix[pos2[0]][(pos2[1] + 1) % 5]
            elif pos1[1] == pos2[1]:  # Одинаковый столбец
                return self.matrix[(pos1[0] + 1) % 5][pos1[1]], self.matrix[(pos2[0] + 1) % 5][pos2[1]]
            else:  # Прямоугольник
                return self.matrix[pos1[0]][pos2[1]], self.matrix[pos2[0]][pos1[1]]
        return None, None  # Возвращает None, если позиции не найдены

    def decrypt_pair(self, pair):
        # Находим позиции символов пары
        pos1 = self.find_position(pair[0])
        pos2 = self.find_position(pair[1])

        if pos1 and pos2:  # Проверяем, что позиции найдены
            if pos1[0] == pos2[0]:  # Одинаковая строка
                return self.matrix[pos1[0]][(pos1[1] - 1) % 5], self.matrix[pos2[0]][(pos2[1] - 1) % 5]
            elif pos1[1] == pos2[1]:  # Одинаковый столбец
                return self.matrix[(pos1[0] - 1) % 5][pos1[1]], self.matrix[(pos2[0] - 1) % 5][pos2[1]]
            else:  # Прямоугольник
                return self.matrix[pos1[0]][pos2[1]], self.matrix[pos2[0]][pos1[1]]
        return None, None  # Возвращает None, если позиции не найдены

    def encrypt(self, plaintext):
        # Подготавливаем текст к шифрованию
        plaintext = self.prepare_text(plaintext)
        encrypted = []
        for i in range(0, len(plaintext), 2):
            pair = plaintext[i:i+2]
            enc1, enc2 = self.encrypt_pair(pair)
            if enc1 and enc2:
                encrypted.extend([enc1, enc2])
            else:
                encrypted.extend([pair[0], pair[1]])  # Запасной вариант в случае ошибки
        return ''.join(encrypted)

    def decrypt(self, ciphertext):
        # Подготавливаем текст к расшифровке
        plaintext = self.prepare_text(ciphertext)
        decrypted = []
        for i in range(0, len(plaintext), 2):
            pair = plaintext[i:i+2]
            dec1, dec2 = self.decrypt_pair(pair)
            if dec1 and dec2:
                decrypted.extend([dec1, dec2])
            else:
                decrypted.extend([pair[0], pair[1]])  # Запасной вариант в случае ошибки
        return ''.join(decrypted)

