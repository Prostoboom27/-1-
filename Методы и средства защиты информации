    while a != 0 and b != 0:
        if a > b:
            a = a % b
        else:
            b = b % a
    return a + b

# Функция генерации ключей RSA
def generate_keys(p, q):
    n = p * q
    phi = (p - 1) * (q - 1)

    # Поиск открытого ключа e
    e = 37
    while GCD(e, phi) != 1:
        e += 1

    # Поиск закрытого ключа d
    d = 0
    i = 0
    while True:
        if (i * e) % phi == 1:
            d = i
            break
        i += 1

    return (e, n), (d, n)

# Функция создания цифровой подписи
def sign_message(m, d, n):
    # Вычисление подписи s = m^d mod n
    return pow(m, d, n)

# Функция проверки цифровой подписи
def verify_signature(m, s, e, n):
    # Проверка подписи: m' = s^e mod n
    m_prime = pow(s, e, n)
    return m == m_prime

# Функция шифрования сообщения
def encrypt_message(message, e, n):
    return [pow(alphabet.find(char), e, n) for char in message]

# Функция расшифрования сообщения
def decrypt_message(encoded_message, d, n):
    return ''.join(alphabet[pow(enc, d, n)] for enc in encoded_message)

