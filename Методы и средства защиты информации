# Определяем алфавит, используемый для шифрования и расшифровки
ALPHABET = [
    'А', 'Б', 'В', 'Г', 'Д', 'Е','Ё', 'Ж', 'З', 'И', 'Й', 'К', 'Л', 'М', 'Н', 'О', 'П',
    'Р', 'С', 'Т', 'У', 'Ф', 'Х', 'Ц', 'Ч', 'Ш', 'Щ', 'Ъ', 'Ы', 'Ь', 'Э', 'Ю', 'Я', ' '
]

#Генерация числового ключа на основе ключевого слова.
def generate_key_numbers(message, keyword):
    key = []  # Список для хранения числового представления ключа
    # Расширяем ключевое слово до длины сообщения
    while len(keyword) < len(message):
        keyword += keyword
    keyword = keyword[:len(message)]

    # Преобразуем каждую букву ключевого слова в индекс алфавита
    for char in keyword:
        key.append(ALPHABET.index(char))

    return key  # Возвращаем ключ в виде списка чисел

    #Шифрование сообщения с использованием ключа.
def generate_code(message, key):
    encoded_message = []  # Список для хранения зашифрованного сообщения
    for i in range(len(message)):
        # Если символ отсутствует в алфавите, добавляем его как есть
        if message[i] not in ALPHABET:
            encoded_message.append(message[i])
            continue
        original_index = ALPHABET.index(message[i])  # Индекс символа в алфавите
        new_index = (original_index + key[i]) % len(ALPHABET)  # Новый индекс
        encoded_message.append(ALPHABET[new_index])  # Добавляем зашифрованный символ
    return ''.join(encoded_message)  # Объединяем список символов в строку

    #Расшифровка сообщения с использованием ключа.
def generate_decode(message, key):
    decoded_message = []  # Список для хранения расшифрованного сообщения
    for i in range(len(message)):
        # Если символ отсутствует в алфавите, добавляем его как есть
        if message[i] not in ALPHABET:
            decoded_message.append(message[i])
            continue
        encrypted_index = ALPHABET.index(message[i])
        new_index = (encrypted_index - key[i]) % len(ALPHABET)
        decoded_message.append(ALPHABET[new_index])  #
    return ''.join(decoded_message)


def main():
    # Исходное сообщение для шифрования
    message = "Антон Павлов".upper()
    # Ключевое слово для шифрования
    keyword = "КЛЮЧ".upper()

    print("Исходное сообщение:", message)
    print("Ключевое слово:", keyword)

    # Генерируем числовой ключ на основе сообщения и ключевого слова
    key = generate_key_numbers(message, keyword)
    print("Числовой ключ:", key)

    # Шифрование сообщения
    encoded_message = generate_code(message, key)
    print("Зашифрованное сообщение:", encoded_message)

    # Расшифровка сообщения
    decoded_message = generate_decode(encoded_message, key)
    print("Расшифрованное сообщение:", decoded_message)

if __name__ == "__main__":
    main()




