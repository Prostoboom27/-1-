import numpy as np

# Алфавит для простого определения числового эквивалента символов
alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ ,.1234567890"

# Функция нахождения наибольшего общего делителя (НОД)
def GCD(a, b):
    """
    Вычисляет наибольший общий делитель двух чисел a и b.
    """
    while a != 0 and b != 0:
        if a > b:
            a = a % b
        else:
            b = b % a
    return a + b

# Ввод шифруемого сообщения
user_string = input("Введите сообщение для шифрования:\n")

# Ввод двух простых чисел p и q
print("Введите два простых числа (p и q):")
p = int(input("p: "))
q = int(input("q: "))

# Вычисление модуля n (произведение двух введённых простых чисел)
n = p * q

# Вычисление значения функции Эйлера \u03C6(n) = (p-1)*(q-1)
phi = (p - 1) * (q - 1)

# Выбор открытой экспоненты e (взаимно простое с \u03C6(n))
e = 3
while GCD(e, phi) != 1:
    e += 2

# Вычисление закрытой экспоненты d (обратное к e по модулю \u03C6(n))
d = 0
i = 1
while True:
    if (i * e) % phi == 1:
        d = i
        break
    i += 1

# Вывод открытого и закрытого ключей
print(f"Открытый ключ: {{e = {e}, n = {n}}}")
print(f"Закрытый ключ: {{d = {d}, n = {n}}}")

# Зашифрование текста
encoded_string = []
for char in user_string:
    num_sym_in_alphabet = alphabet.find(char)
    enc_sym = (num_sym_in_alphabet ** e) % n
    encoded_string.append(enc_sym)

print("Зашифрованное сообщение:", encoded_string)

# Расшифрование текста
decoded_string = ""
for enc_sym in encoded_string:
    num_sym_in_alphabet = (enc_sym ** d) % n
    decoded_string += alphabet[num_sym_in_alphabet]

print("Расшифрованное сообщение:", decoded_string)





