void shellSort(double* pData, int DataSize) {

	int gap = 1;

	while (gap < DataSize / 3) {
		gap = 3 * gap + 1;
	}

	while (gap >= 1) {
		for (int i = gap; i < DataSize; ++i) {
			int temp = pData[i];
			int j = i;

			while (j >= gap && pData[j - gap] > temp) {
				pData[j] = pData[j - gap];
				j -= gap;
			}

			pData[j] = temp;
		}

		gap /= 3;
	}
}

void swap(int& a, int& b) {
	int temp = a;
	a = b;
	b = temp;
}

int partition(double* pData, int low, int Datasize) {
	int pivot = pData[Datasize];

	int i = low - 1; 

	for (int j = low; j <= Datasize - 1; j++) {
		if (pData[j] <= pivot) {
			i++;
			swap(pData[i], pData[j]);
		}
	}

	swap(pData[i + 1], pData[Datasize]);
	return i + 1;
}

void quickSort(double* pData, int low, int DataSize) {
	if (low < DataSize) {
		int pi = partition(pData, low, DataSize);

		quickSort(pData, low, pi - 1); 
		quickSort(pData, pi + 1, DataSize); 
	}
}
void parallelQuickSort(double pata[], int low, int DataSize, int depth) {
	if (low < DataSize) {
		if (depth <= 6) {
			
			sort(pata + low, pata + DataSize + 1);
		}
		else {
			int pi = partition(pata, low, DataSize);

			thread leftThread(parallelQuickSort, ref(pata), low, pi - 1, depth - 1);
			thread rightThread(parallelQuickSort, ref(pata), pi + 1, DataSize, depth - 1);
			leftThread.join();
			rightThread.join();
		}
	}
}

void hyperQuickSort(double pData[], int low, int DataSize, int cutoff) {
	if (low < DataSize) {
		if (DataSize - low < cutoff) {
			sort(pData + low, pData + DataSize + 1);
		}
		else {
			int pi = partition(pData, low, DataSize);

			thread left_thread(hyperQuickSort, ref(pData), low, pi - 1, cutoff);
			thread right_thread(hyperQuickSort, ref(pData), pi + 1, DataSize, cutoff);
			left_thread.join();
			right_thread.join();
		}
	}
}
