Задание: Дано бинарное дерево. Кроме того все вершины имеют цвет. Всего 3 цвета (белый, черный и желтый). Из множества листьев имеющих желтый цвет удалить самые далекие от корня, если таковых нет, то из множества листьев имеющих черных или белый цвет удалить самые близкие от корня.
 
Код программы:
#define _CRT_SECURE_NO_WARNINGS 
//Задача 28. Дано бинарное дерево. Кроме того все вершины имеют цвет. 
//Всего 3 цвета (белый, черный и желтый). 
//Из множества листьев имеющих желтый цвет удалить самые далекие от корня, если таковых нет, 
//то из множества листьев имеющих черных или белый цвет удалить самые близкие от корня.
#include <iostream>
#include <stdio.h>

struct tree {
    int key;
    int colors;
    struct tree* left;
    struct tree* right;
};

struct tree* createtree(int word, int key)
{
    struct tree* elem = new struct tree;
    elem->colors = word;
    elem->key = key;
    elem->left = NULL;
    elem->right = NULL;
    return elem;
}

void inserttree(struct tree* root, struct tree* el)
{
    if (el->key < root->key)
    {
        if (root->left == NULL) { root->left = el; }
        else { inserttree(root->left, el); }
    }
    else {
        if (root->right == NULL) { root->right = el; }
        else { inserttree(root->right, el); }
    }


}

void proverka(struct tree* root, int lvl, int maxlevel, bool& bol)
{

    if (root->left != NULL) {
        proverka(root->left, lvl + 1, maxlevel, bol);
    }
    if (root->right != NULL) {
        proverka(root->right, lvl + 1, maxlevel, bol);
    }

    if (lvl + 1 == maxlevel && root->colors == 3) { bol = true; }

}

struct tree* deleteLeaves(struct tree* root, int lvl, int maxlevel)
{
    struct tree* tmp;
    bool bol = false;
    if (root == NULL) { return root; }
    proverka(root, lvl, maxlevel, bol);
    if (root->left != NULL) {
        deleteLeaves(root->left, lvl + 1, maxlevel);
    }
    if (root->right != NULL) {
        deleteLeaves(root->right, lvl + 1, maxlevel);
    }

    if (bol == true) {

        if (lvl + 1 == maxlevel && root->colors == 3) {
            if (root->left == NULL && root->right == NULL)
            {
                tree* temp = root;
                root->colors = NULL;
                return temp;
            }

        }
    }
    else {
        if (((maxlevel - (lvl + 1)) == 1 && root->colors == 1) || ((maxlevel - (lvl + 1)) == 1 && root->colors == 2)) {
            if (root->left == NULL && root->right == NULL)
            {
                tree* temp = root;
                root->colors = NULL;
                return temp;
            }
        }
    }
    return root;
}

void findLevel(struct tree* leaves, int level, int& maxlevel)
{
    if (leaves != NULL)
    {
        findLevel(leaves->left, ++level, maxlevel);


        if (level > maxlevel)
        {
            maxlevel = level;
        }
        findLevel(leaves->right, level, maxlevel);
    }
}

void FreeTree(struct tree* root) {
    if (root->left != NULL)   FreeTree(root->left);
    if (root->right != NULL)  FreeTree(root->right);
    delete root;
}

void printBT(const std::string& prefix, const tree* node, bool isLeft)
{
    if (!node) return;
    if (node != NULL)
    {
        std::cout << prefix;

        std::cout << (isLeft ? "|---" : "L---");
        //std::cout << node->colors<<std::endl;

        if (node->colors == 1) { printf("Белый\n"); }
        if (node->colors == 2) { printf("Черный\n"); }
        if (node->colors == 3) { printf("Желтый\n"); }
        printBT(prefix + (isLeft ? "|   " : "    "), node->right, true);
        printBT(prefix + (isLeft ? "|   " : "    "), node->left, false);
    }
}

void printBT(const tree* node)
{
    printBT("", node, false);
}

void printTree(struct tree* root)
{
    if (root != NULL) {
        if (root->colors == 1) { printf("Белый\n"); }
        if (root->colors == 2) { printf("Черный\n"); }
        if (root->colors == 3) { printf("Желтый\n"); }
        printTree(root->left);
        printTree(root->right);
    }
}

