Задание: Дано N-дерево. Найти все вершины с одинаковыми номерами.
Код программы: 
#include <iostream>

int SIZE{ 3 }; //определяет арность дерева
int coute = 0;
using namespace std;
struct Tree
{
	int Value; 		//значение в узле
	int SizeChild; 	//Кол-во узлов в поддереве с корнем в данном
	Tree** child;   //Массив потомков
	Tree() : Value(), SizeChild(1), child(new Tree* [SIZE]) { for (int i = 0; i < SIZE; i++) child[i] = 0; }
};

class NTree
{
private:
	Tree* root;						//корень дерева
	int* Array;						//массив со всеми значениями в дереве
	int ArrSize = 0;				//кол-во значений в дереве
	void FindEqul(Tree* T);			//Поиск одинаковых чисел
	int Add(char*& str, Tree*& T);	//Добавление значений в дерево
	void PrintTree(Tree* T, int sh);//Вывод дерева
	void FreeNTree(Tree* T);		//Удаление дерева
	void sort(int* Arr);			//Сортировка 
public:
	NTree();					//Конструктор
	~NTree();					//Диструктор
	bool AddItems(char* str);	//Обертка для Add с проверкой на существования дерева
	void Print();				//Обертка для PrintNTree
	void PrintEqule();			//Вывод равных значений
};

int NTree::Add(char*& str, Tree*& T) {
	int Count = 0; //Здесь накапливаем узлы поддерева
	int m = 0; //Хранит значение count в поддеревьях
	if (isdigit(*str)) {  //Если ветки не существует
		T = new Tree(); //Создаем ее и задаем значение
		Count = 1; 		 //Запоминаем, что в поддереве с корнем в этом узле есть 1 узел
		do {
			T->Value = T->Value * 10 + *str++ - '0';
		} while (isdigit(*str));//пока в строке есть цифры добавляем их
		for (int i = 0; i < SIZE; i++)
		{
			if (*str == '(' && (m = Add(++str, T->child[i])) >= 0 && *str == ')')
			{
				++str, Count += m;
			}
		}
		return T->SizeChild = Count;
	}
	else if (*str == ')') return Count;
	else return -1;
}
bool NTree::AddItems(char* str) {
	int m = 0;
	if (*str == '(')
	{
		m = Add(++str, root);
		if (m == -1) return false;
		if (*str == ')' && *++str == 0) {
			Array = new int[root->SizeChild];
			ArrSize = root->SizeChild;
			return true;
		}
		else return false;
	}
	return false;
}
void NTree::PrintTree(Tree* T, int sh) {
	if (!T) return;
	for (int j = 0; j < sh; j++)
		cout << ' ';
	cout << T->Value << endl;
	for (int i = 0; i < SIZE; i++)
		PrintTree(T->child[i], sh + 5);
}
void NTree::Print() {
	PrintTree(root, 0);
	cout << endl;
}
void NTree::FreeNTree(Tree* T) {
	if (!T) return;
	for (int i = 0; i < SIZE; i++)
	{
		FreeNTree(T->child[i]);
	}
	delete T;
	return;
}
void NTree::FindEqul(Tree* T) {
	if (!T) return;
	for (int i = 0; i < SIZE; i++)
	{
		FindEqul(T->child[i]);
	}
	Array[coute] = T->Value;
	coute++;
	return;
}
void NTree::sort(int* Arr) {
	for (int i = 0; i < root->SizeChild; i++) {
		for (int j = 0; j < root->SizeChild - 1; j++) {
			if (Arr[j] > Arr[j + 1]) {
				int temp = Arr[j]; // создали дополнительную переменную
				Arr[j] = Arr[j + 1]; // меняем местами
				Arr[j + 1] = temp; // значения элементов
			}
		}
	}
}
void NTree::PrintEqule() {
	FindEqul(root);
	sort(Array);
	int temp = Array[0];
	int k = 1;
	for (int i = 1; i <= ArrSize; i++)
	{
		if (i < ArrSize && Array[i] == temp)
			k++;
		else {
			if (k > 1)
				for (int j = 0; j < k; j++)
					cout << temp << ' ';
			if (i < ArrSize)
			{
				temp = Array[i];
				k = 1;
			}
		}
	}
	cout << endl;
}
NTree::NTree()
{
	root = nullptr;
}

NTree::~NTree()
{
	FreeNTree(root);
}

