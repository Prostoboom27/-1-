//Функция для создания нового узла
void create_new_node(class Node** start, int non_zero_element, int row_index, int column_index)
{
    Node* temp, * newNode;
    temp = *start;

    if (temp == NULL)
    {
        // Динамически создается новый узел
        temp = (class Node*)malloc(sizeof(class Node));
        temp->value = non_zero_element;
        temp->row_index = row_index;
        temp->index_j_column = column_index;
        temp->next = NULL;
        *start = temp;
    }
    else
    {
        while (temp->next != NULL) temp = temp->next;

        newNode = (class Node*)malloc(sizeof(class Node));
        newNode->value = non_zero_element;
        newNode->row_index = row_index;
        newNode->index_j_column = column_index;
        newNode->next = NULL;
        temp->next = newNode;
    }
}

