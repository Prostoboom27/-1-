Задачние: Даны К целых чисел А(1),...,А(К). Вычислить
а) наибольшее,
b) наименьшее,
c) наиболее близкое к нулю.
Код программы:

//Даны К целых чисел А(1),...,А(К). Вычислить
//а) наибольшее,
//b) наименьшее,
//c) наиболее близкое к нулю.

#include <iostream>
using namespace std;

int main()
{
    setlocale(LC_ALL, "rus");   //для отображения русского языка
    int number_of_Elements;     //для общего количества элементов
    int temp;                   //для замены местами данных массива
    cout << "Введите количество элементов в массиве: ";
    //проверка на положительный ввод
    do {
        cin >> number_of_Elements;
        //предложится повторный ввод, если пользователь ввел данные <= 0
        if (number_of_Elements <= 0)
            cout << "Введите положительное целое число: ";
    } while (number_of_Elements <= 0);
    //выделяем память под динамический массив
    int* data_array = new int[number_of_Elements];

    //заполняем массив данными
    for (int i = 0; i < number_of_Elements; i++) {
        cout << i + 1 << " значение = ";
        cin >> data_array[i];
    }
    cout << endl;
    //сортирует массив по возрастанию
    for (int i = 1; i < number_of_Elements; i++) {

        //меняются местами значения, 
        //если текущий элемент больше последующего
        if (data_array[i - 1] > data_array[i])
        {
            temp = data_array[i - 1];
            data_array[i - 1] = data_array[i];
            data_array[i] = temp;
            i = 0;  //пробегаем по массиву заново, чтобы сравнить поменянное значение со всеми предыдущими в списке
        }
    }
    cout << "отсортированный массив на " << number_of_Elements << " элементов:" << endl;
    //вывод отсортированного массива
    for (int i = 0; i < number_of_Elements; i++) {
        cout << i + 1 << " значение: " << data_array[i] << endl;
    }
    cout << endl;

    //в сортированном списке по возрастанию последний элемент является наибольшим
    cout << "наибольшее значение = " << data_array[number_of_Elements - 1] << endl;
    //а первый, соответственно, наименьшим
    cout << "наименьшее значение = " << data_array[0] << endl;

    int near = data_array[0];
    //ищет ближайшее значение к 0
    for (int i = 0; i < number_of_Elements; i++) {
        //сравнение идет по модулю
        if (abs(near) > abs(data_array[i])) {
            near = data_array[i];
        }
    }
    cout << "ближайшее значение к 0 = " << near << endl;
    //высвобождаем выделенную память
    delete[] data_array;
    return 0;
}


