template <class T>
T si(const std::string& _err, std::function<bool(T)> _comp)
{
    // nullptr - default
    if (_comp == nullptr) _comp = [](T) {return true; };

    T result;

    // std::cin >> ... вернет не 0, если там ошибка
    while (!(std::cin >> result) || (std::cin.peek() != '\n') || !_comp(result))
    {
        // очищаем и пишем в вывод ошибку
        std::cin.clear();
        std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
        std::cout << _err;
    }
    return result;
}

