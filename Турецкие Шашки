#ifndef FIELD_H
#define FIELD_H

#include "outline.h"

#include <cmath>
#include <iostream>
#include <functional>

// класс поля
class Field
{
private:
    // перечисление сущностей, допустимых в клетке
    enum class Entity
    {
        NONE = 0,
        WHITE = 1,
        BLACK = 2,
        WHITE_QUEEN = 3,
        BLACK_QUEEN = 4
    };

    // само игровое поле
    Entity** m_field;

    // за кого играет пользователь и его оппонент
    Entity m_player;
    Entity m_opponent;

    // размер поля 8x8
    const int m_size = 8;

    // глубина ходов
    const int m_depth = 3;

    // вернет сусщность дамки цвета отданной шашки
    Entity toQueen(const Entity& _entity) const;

    // метод рекурсивного вызова
    int __MiniMax(const Field& _field, const int _depth, const Entity& _player, int _alpha, int _beta, bool _killed = false) const;

    // проверка на дамок
    void queenCheck();

public:
    // описание событий, которые могут возникнуть после перемещения шашки
    enum class MoveEvent
    {
        ERR = -1,
        MOVED = 0,
        KILLED = 1
    };

    // конструктор по умолчанию
    Field();

    // конструктор копирование
    Field(const Field& _other);

    // деструктор по умолчанию
    ~Field();

    // перемещает шашку
    MoveEvent move(int _i1, int _j1, int _i2, int _j2, bool _killed);

    // делает из шашки дамку
    void setQueen(int _i, int _j);

    // 0 - black, 1 - white
    void setPlayer(int _color);

    // метод вывода
    void print() const;

    // оценочная функция
    int rate() const;

    // МиниМакс - вернет наилучшее поле
    Field MiniMax() const;

    // подсчет шашек
    size_t whiteCount() const;
    size_t blackCount() const;

    Field& operator= (const Field& _other);
};

#endif // FIELD_H#pragma once

